# Copy to .env.local and fill in. .env.local is gitignored.
# Vite bakes these into the build, so run `npm run build` after changing them.

# Apps Script web app URL from Deploy > New deployment (ends in /exec)
VITE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/<deployment-id>/exec
# Must match the SHARED_SECRET script property in Apps Script
VITE_SHEETS_SECRET=<same value as SHARED_SECRET>
